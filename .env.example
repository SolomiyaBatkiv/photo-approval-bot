# Токен від @BotFather
BOT_TOKEN=

# Telegram ID апрувера (дізнатися: /id у цьому боті або @userinfobot)
APPROVER_ID=



# Google Таблиця + Drive: URL вебзастосунку Apps Script і секрет (як у apps_script.gs)
SHEETS_WEBHOOK_URL=
SHEETS_SECRET=



# Режим: polling (за замовчуванням) або webhook
BOT_MODE=polling
# HTTP-порт для /healthz і /telegram/webhook
PORT=8080
# Для webhook: публічна HTTPS-адреса бота і секрет (A-Z a-z 0-9 _ -, до 256 символів)
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=
